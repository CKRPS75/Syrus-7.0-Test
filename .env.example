# TrustRoute Environment Configuration Template
# Copy this file to .env and insert your personal API keys

# 1. Google Gemini API Key (Recommended / Fast)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# 2. OpenAI API Key (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# 3. Reference & Configuration Overrides
REFERENCE_DATA_PATH=data/mumbai_reference.json
TRUST_CONFIG_PATH=config/trust.json
