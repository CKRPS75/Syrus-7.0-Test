# Database configuration
DATABASE_URL=postgresql+psycopg://trustroute:password@localhost:5432/trustroute

# Application configuration
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
PROJECT_NAME=TrustRoute API

# Server configuration
HOST=0.0.0.0
PORT=8000

# Security & Authentication (JWT & OTP)
SECRET_KEY=trustroute_master_secret_key_2026_production_change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
TRUSTROUTE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM & Bayesian Evidence (Person 2)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# OTP & Routing (Person 3)
OTP_GRAPHQL_URL=http://localhost:8080/otp/routers/default/index/graphql
OTP_ROUTER_ID=default

# City & Dataset Paths
CITY_CODE=mumbai
CITY_CONFIG_PATH=cities/mumbai/config.json
TRUST_CONFIG_PATH=config/parameters.json
REFERENCE_DATA_PATH=data/mumbai_reference.json
CROWD_PRIORS_PATH=app/data/mumbai_crowd_priors.json
TOURIST_ATTRACTIONS_PATH=cities/mumbai/tourist_attractions.json
