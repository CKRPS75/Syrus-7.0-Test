# Database configuration
DATABASE_URL=postgresql://username:password@localhost:5432/trustroute

# Application configuration
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
PROJECT_NAME=TrustRoute API

# Server configuration
HOST=0.0.0.0
PORT=8000
# 2. OpenAI API Key (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# 3. Reference & Configuration Overrides
REFERENCE_DATA_PATH=data/mumbai_reference.json
TRUST_CONFIG_PATH=config/trust.json

# 4. Authentication (backend only; never expose these values with NEXT_PUBLIC_)
# PostgreSQL connection string; set DATABASE_URL in the backend environment.
# DATABASE_URL=postgresql://username:password@localhost:5432/trustroute
# Comma-separated exact frontend origins allowed to send credentialed requests.
TRUSTROUTE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
